# Keep shell scripts + Dockerfiles + compose files as LF — they're consumed
# on Linux, and CRLF endings cause "bad interpreter" / parse errors there.
*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Caddyfile   text eol=lf
*.conf      text eol=lf

# Mark binary files explicitly so git doesn't try to munge them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.xlsx binary
