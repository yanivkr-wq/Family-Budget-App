# ============================================================================
# Family Budget App — Environment Variables (example)
# Copy to .env.local for development; set on the VPS for production.
# NEVER commit a real .env file.
# ============================================================================

# --- Domain / URLs ---
APP_URL=https://budget.example.com
WORKER_INTERNAL_URL=http://worker:8080  # used by web -> worker inside docker

# --- Database (Postgres) ---
DATABASE_URL=postgresql://budget:CHANGE_ME@postgres:5432/budget
# For migrations / drizzle-kit (host network during dev)
DATABASE_URL_DIRECT=postgresql://budget:CHANGE_ME@localhost:5432/budget

# --- Master encryption key (32 random bytes, base64) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt: bank credentials, chat message contents.
MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_BASE64_32_BYTES
AUTH_URL=https://budget.example.com
AUTH_TRUST_HOST=true

# Optional: SMTP for magic-link email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Budget App <noreply@example.com>"

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Models (don't change unless you know what you're doing)
ANTHROPIC_MODEL_CATEGORIZER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CHATBOT=claude-sonnet-4-6

# --- Backups (Backblaze B2) ---
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=family-budget-backups
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
GPG_RECIPIENT=you@example.com  # GPG key ID for backup encryption

# --- Application settings ---
TZ=Asia/Jerusalem
DEFAULT_CUTOFF_DAY=10  # Default credit-card cutoff day (per-card override in DB)
SCRAPE_CRON="0 6 * * *"  # Daily 06:00 IDT
LOG_LEVEL=info
NODE_ENV=production
