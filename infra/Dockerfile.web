# Multi-stage build for the Next.js frontend.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ---- deps stage ----
# IMPORTANT: copy package.json for EVERY workspace package the web app
# depends on (directly or transitively). Missing one → ERR_PNPM_WORKSPACE_PKG_NOT_FOUND.
# Web currently uses: db, shared, categorizer. (Chatbot is worker-only.)
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/categorizer/package.json packages/categorizer/
RUN pnpm install --frozen-lockfile=false

# ---- build stage ----
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/categorizer/node_modules ./packages/categorizer/node_modules
COPY . .
RUN pnpm --filter @fba/web build

# ---- runtime stage ----
FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
# `public/` is committed (with .gitkeep) so the COPY never fails. Docker
# COPY does NOT support shell redirection — that's why the previous
# `2>/dev/null || true` was being parsed as extra source paths.
COPY --from=build --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
