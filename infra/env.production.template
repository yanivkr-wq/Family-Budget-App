# ============================================================================
# Family Budget App — PRODUCTION env file template
# ============================================================================
# Copy this to ../.env on the server (NOT committed to git!), fill in the
# placeholders, then run `docker compose up -d`.
#
# How to generate the random values: see infra/README.md "Step 4 — Secrets"
# (uses `openssl rand -base64 32` — safe + standard).

# --- Domain / URLs ---
# In IP-only mode (no domain yet): use http://<server-ip>
# After registering a domain: replace with https://your-domain.com
APP_URL=http://178.105.83.23
WORKER_INTERNAL_URL=http://worker:8080

# --- Database ---
# The password MUST match the value in infra/secrets/postgres_password.
# Username/db are hard-coded in the postgres container's POSTGRES_USER /
# POSTGRES_DB and in this URL.
DATABASE_URL=postgresql://budget:REPLACE_WITH_PG_PASSWORD@postgres:5432/budget
DATABASE_URL_DIRECT=postgresql://budget:REPLACE_WITH_PG_PASSWORD@postgres:5432/budget

# --- Master encryption key (32 random bytes, base64) ---
# Encrypts: bank scraper credentials, chat message contents.
# CRITICAL: back this up to a password manager. Lost key = unrecoverable
# encrypted data.
MASTER_KEY=GENERATE_ME_ON_SERVER

# --- Auth.js (NextAuth) ---
AUTH_SECRET=GENERATE_ME_ON_SERVER
AUTH_URL=http://178.105.83.23
AUTH_TRUST_HOST=true

# --- Worker internal token (web ↔ worker auth) ---
WORKER_INTERNAL_TOKEN=GENERATE_ME_ON_SERVER

# --- Anthropic Claude API ---
# Reuse your dev key OR create a separate prod key for billing isolation.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODEL_CATEGORIZER=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CHATBOT=claude-sonnet-4-6

# --- Email (Gmail SMTP — optional, leave blank to disable email channel) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yanivkr@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=Family Budget App <yanivkr@gmail.com>

# --- WhatsApp (Twilio sandbox — optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Backups (Backblaze B2) ---
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_BUCKET=family-budget-backups
B2_KEY_ID=YOUR_B2_KEY_ID
B2_APP_KEY=YOUR_B2_APP_KEY
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30
# IMPORTANT: leave UNSET in production. Setting it would force the worker
# to try `docker exec` (which won't work — the worker container doesn't
# have the docker socket). Unset = direct pg_dump over the docker network.
# BACKUP_PG_DOCKER_CONTAINER=

# --- Application settings ---
TZ=Asia/Jerusalem
DEFAULT_CUTOFF_DAY=10
SCRAPE_CRON=0 6 * * *
REMINDER_CRON=*/5 * * * *
LOG_LEVEL=info
NODE_ENV=production
