# Worker image: Fastify + scrapers (Puppeteer + Chromium) + pg_dump for backups.
FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

# Chromium for the Israeli bank scrapers + postgresql-client-16 for backups
# (pg_dump must be the same major version as the server — postgres 16 in
# our compose). Bookworm only ships client 15 in main repos, so we pull
# the official Postgres APT repo for the 16 client.
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        ca-certificates \
        curl \
        gnupg \
        fonts-liberation \
        fonts-freefont-ttf \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2 \
        dumb-init \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---- deps ----
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/worker/package.json apps/worker/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/categorizer/package.json packages/categorizer/
COPY packages/chatbot/package.json packages/chatbot/
RUN pnpm install --frozen-lockfile=false

# ---- build (typecheck only — actual execution uses tsx at runtime) ----
# We don't tsc-compile the worker because the source uses extension-less
# imports (import './config' instead of './config.js'), which would break
# under Node's strict ESM resolver. tsx handles both styles transparently
# and starts in <500ms, so the dev → prod path is identical.
FROM deps AS build
COPY . .
RUN pnpm --filter @fba/worker build

# ---- runtime ----
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=build /app/apps/worker/src ./apps/worker/src
COPY --from=build /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build /app/apps/worker/tsconfig.json ./apps/worker/tsconfig.json
COPY --from=build /app/packages ./packages
COPY --from=build /app/tsconfig.base.json ./tsconfig.base.json

ENTRYPOINT ["dumb-init", "--"]
EXPOSE 8080
CMD ["./apps/worker/node_modules/.bin/tsx", "apps/worker/src/server.ts"]
